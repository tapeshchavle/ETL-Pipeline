  create  table "foodingo_warehouse"."analytics_analytics"."ml_user_order_matrix__dbt_tmp"
  
  
    as
  
  (
    -- models/marts/ml_user_order_matrix.sql
-- User × Food order count matrix — input for collaborative filtering recommender



WITH exploded AS (
    SELECT
        user_id,
        jsonb_array_elements(ordered_items)->>'foodId' AS food_id
    FROM "foodingo_warehouse"."analytics_analytics"."fact_orders"
    WHERE payment_status = 'paid'
      AND user_id IS NOT NULL
)

SELECT
    user_id,
    food_id,
    COUNT(*)   AS order_count
FROM exploded
WHERE food_id IS NOT NULL
GROUP BY user_id, food_id
  );
  
